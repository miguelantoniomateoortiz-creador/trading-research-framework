{
  "name": "@trf/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capa de persistencia: esquema Prisma/SQLite y acceso de alto rendimiento vía better-sqlite3.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "mkdir -p ../../data/db && prisma migrate dev --name init",
    "deploy": "mkdir -p ../../data/db && prisma migrate deploy",
    "reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@trf/shared": "workspace:*",
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "prisma": "^5.20.0"
  }
}
